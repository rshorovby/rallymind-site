# macOS
.DS_Store

# Рендеры для ревью: регенерируются командой tools/render-site.mjs,
# в репозитории им делать нечего — 4 МБ, которые каждый раз меняются.
preview/

# На случай, если появится node-обвязка. Скрипты в tools/ работают
# на голом Node без зависимостей.
node_modules/

# screens/ и fonts/ — НЕ игнорировать: это исходные PNG и TTF,
# из которых собираются assets/img/*.webp и assets/fonts/*.woff2.
# Восстановить их больше неоткуда.

# Сборка для Cloudflare Pages. Собирается tools/export-site.sh.
dist/

# Токен деплоя. В репозиторий не класть.
.env
.env.*
!.env.example

# Локальный кеш Wrangler после tools/deploy.sh.
.wrangler/
